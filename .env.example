# Example process environment. The application does not load this file itself.
# HTTP settings below have defaults. DATABASE_URL is required. Durations must be positive.
HTTP_ADDR=127.0.0.1:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info

# Mockbank
MOCKBANK_HTTP_ADDR=127.0.0.1:8081
MOCKBANK_DEMO_TOKEN=dev_token_123

# Existing local PostgreSQL (pgAdmin), not the optional Docker instance.
# The API uses postgres://; the migration CLI built with pgx5 uses pgx5://.
# Keep passwords in the local PostgreSQL password file or process environment.
DATABASE_URL=postgres://postgres@localhost:5432/openBanking?sslmode=disable
MIGRATION_DATABASE_URL=pgx5://postgres@localhost:5432/openBanking?sslmode=disable
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=5s
DB_STARTUP_TIMEOUT=10s
DB_STATEMENT_TIMEOUT=30s
DEMO_USER_ID=00000000-0000-4000-8000-000000000100

# Optional Docker Compose instance. Set a local password before starting Compose.
POSTGRES_DB=openBanking
POSTGRES_USER=postgres
POSTGRES_PORT=5433
POSTGRES_PASSWORD=
