# Example process environment. The application does not load this file itself.
# Empty or unset variables use these defaults. Durations must be positive.
HTTP_ADDR=127.0.0.1:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info

# Mockbank
MOCKBANK_HTTP_ADDR=127.0.0.1:8081
MOCKBANK_DEMO_TOKEN=dev_token_123

# Migration CLI only; the API does not use these settings until PostgreSQL is wired.
# Store the password in the local PostgreSQL password file, not in this URL.
MIGRATION_DATABASE_URL=pgx5://postgres@localhost:5432/openBanking?sslmode=disable
DEMO_USER_ID=00000000-0000-4000-8000-000000000100
